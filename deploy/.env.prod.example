# Copy to deploy/.env.prod on the droplet (chmod 600). Never commit the real file.
# Same value as ORIGIN_SECRET in Vercel's project settings:  openssl rand -hex 32
ORIGIN_SECRET=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The address people open, e.g. https://bbb-library.vercel.app
PUBLIC_SITE_URL=
# Droplet hostname for the certificate: the IP with dots as dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
SITE_ADDRESS=
