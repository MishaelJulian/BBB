# Backend (read by app/core/config.py)
ENV=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./book_club_archivist.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/bbb_library

# Extra browser origins allowed to call the API directly (comma-separated), e.g. https://bbb.example.org
# CORS_ORIGINS=

# Proxy origin lock (production only): the same random value in Vercel and here. openssl rand -hex 32
# ORIGIN_SECRET=

# Login service (Better Auth). Secret: openssl rand -base64 32. Never commit the real value.
BETTER_AUTH_SECRET=
# Public site address the browser uses (Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000
AUTH_INTERNAL_URL=http://127.0.0.1:3001
# AUTH_REQUIRED=false   # only for local work without the auth service
